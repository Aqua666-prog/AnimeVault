<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Adaptive icon XML itself requires an API-qualified resource directory. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!-- The monochrome variants live in the API 33 override by design. -->
    <issue id="MonochromeLauncherIcon">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!--
        AnimeVault is an application, not a reusable library. Media3 explicitly
        supports project-wide opt-in for applications that intentionally use
        its @UnstableApi surface. This keeps lint strict for every other issue.
    -->
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="androidx.media3.common.util.UnstableApi" />
    </issue>
</lint>
